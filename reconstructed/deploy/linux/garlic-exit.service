[Unit]
Description=Garlic Infinite Storage and Relay v2 exit
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=%h/.config/garlic/exit.env
ExecStart=%h/.local/bin/garlic-infinite-storage
WorkingDirectory=%h/.local/share/garlic/exit
Restart=on-failure
RestartSec=3s
UMask=0077

[Install]
WantedBy=default.target
