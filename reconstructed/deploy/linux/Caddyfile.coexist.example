# Use the existing public name and the backend's trusted TLS hostname.
{$GARLIC_PUBLIC_NAME} {
    @legacyTunnel path /v1/tunnel /v1/dns
    handle @legacyTunnel {
        @wrongProtocol expression `{http.request.proto} != "HTTP/2.0"`
        respond @wrongProtocol "HTTP/2 required" 505
        reverse_proxy h2c://127.0.0.1:8070 {
            flush_interval -1
        }
    }

    @legacyQueue {
        path /tasks /tasks/* /workers/claim /workers/complete
        header X-Garlic-Key *
        header !Authorization
    }
    handle @legacyQueue {
        reverse_proxy 127.0.0.1:8080
    }

    @legacyExecute {
        path /execute
        header X-Garlic-Key *
        header !Authorization
    }
    handle @legacyExecute {
        reverse_proxy 127.0.0.1:8090
    }

    handle {
        reverse_proxy https://{$GARLIC_MODERN_BACKEND} {
            transport http {
                tls_server_name {$GARLIC_MODERN_TLS_NAME}
            }
        }
    }
}
