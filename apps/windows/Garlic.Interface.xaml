<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Garlic" Width="960" Height="760" MinWidth="840" MinHeight="680" Background="#171717" Foreground="#F3F3F3" FontFamily="Segoe UI" FontSize="14" Language="ru-RU" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Background" Value="#292929"/><Setter Property="Foreground" Value="#F3F3F3"/><Setter Property="Padding" Value="16,11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#BBBBBB"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="14,12"/></Style>
<Style TargetType="TextBox"><Setter Property="Height" Value="44"/><Setter Property="Background" Value="#262626"/><Setter Property="Foreground" Value="#F3F3F3"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="12"/><Setter Property="BorderBrush" Value="#424242"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="PasswordBox"><Setter Property="Height" Value="44"/><Setter Property="Background" Value="#262626"/><Setter Property="Foreground" Value="#F3F3F3"/><Setter Property="Padding" Value="12"/><Setter Property="BorderBrush" Value="#424242"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F3F3F3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
<Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="14,13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#252525"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#333333"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E5E5E5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderBrush="#777777" BorderThickness="1" Margin="0,0,10,0" Background="#262626"><TextBlock x:Name="Mark" Text="✓" Visibility="Collapsed" Foreground="#171717" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#EEEEEE"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ContextMenu"><Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="#282828" BorderBrush="#444444" BorderThickness="1" CornerRadius="12" Padding="6"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="MenuItem"><Setter Property="Foreground" Value="#F3F3F3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Item" Background="Transparent" CornerRadius="7" Padding="14,11"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#414141"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ScrollBar"><Setter Property="Width" Value="5"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb Background="#555555"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="{TemplateBinding Background}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#1E1E1E" Padding="18,28"><DockPanel><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="10,0,0,36"><Image x:Name="Logo" Width="27" Height="34"/><TextBlock Text="Garlic" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel><Button x:Name="PluginsButton" Style="{StaticResource Nav}" Content="Плагины"/><Button x:Name="UpdateButton" Style="{StaticResource Nav}" Content="Обновить с GitHub" Visibility="Collapsed"/><Button x:Name="LogsButton" Style="{StaticResource Nav}" Content="Журнал"/><Button x:Name="HomeButton" Style="{StaticResource Nav}" Content="Подключение"/><Button x:Name="UsersButton" Style="{StaticResource Nav}" Content="Пользователи" Visibility="Collapsed"/><Button x:Name="ServersButton" Style="{StaticResource Nav}" Content="Серверы" Visibility="Collapsed"/></StackPanel><TextBlock Text="Личная сеть" Foreground="#777777" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Bottom"/></DockPanel></Border>
<Grid Grid.Column="1" Margin="32,30"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid>
<StackPanel x:Name="Auth" MaxWidth="370" VerticalAlignment="Center"><TextBlock Text="Подключиться к Garlic" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Адрес любого сервера сети и ваш ключ." Foreground="#A6A6A6" Margin="0,12,0,30"/><TextBlock Text="Сервер" Margin="0,0,0,8"/><TextBox x:Name="Server"/><TextBlock Text="Ключ доступа" Margin="0,20,0,8"/><PasswordBox x:Name="Key" Background="#262626" Foreground="White" Padding="12" BorderBrush="#424242" BorderThickness="1"/><Button x:Name="Login" Content="Продолжить" Background="#EEEEEE" Foreground="#171717" Margin="0,26,0,0"/></StackPanel>
<ScrollViewer x:Name="Home" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="370" VerticalAlignment="Center"><TextBlock x:Name="Connection" Text="Не подключено" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="Subscription" Foreground="#A6A6A6" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,16"/><TextBlock x:Name="RouteInfo" Foreground="#A6A6A6" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,28"/><Button x:Name="Power" Content="Подключить" Background="#EEEEEE" Foreground="#171717" Height="54"/><TextBlock Text="Режим подключения" Foreground="#A6A6A6" Margin="0,24,0,8"/><Button x:Name="TunnelMode" Content="VPN (вся система)  ⌄" HorizontalContentAlignment="Left"/><TextBlock x:Name="TunnelHint" Text="Маршрутизирует весь трафик устройства (требуются права администратора)." TextWrapping="Wrap" Foreground="#888888" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="Маршрут" Foreground="#A6A6A6" Margin="0,18,0,8"/><Button x:Name="Route" Content="Автоматически  ⌄" HorizontalContentAlignment="Left"/><TextBlock Text="Сначала напрямую. Через Россию — при недоступности." TextWrapping="Wrap" Foreground="#888888" FontSize="12" Margin="0,8,0,20"/><Button x:Name="Takeover" Content="Переключить на это устройство" Margin="0,0,0,12"/><CheckBox x:Name="ShowStatistics" Content="Показывать скорость и отклик" Margin="0,0,0,12"/><TextBlock x:Name="Statistics" Foreground="#A6A6A6" FontSize="12" TextAlignment="Center" Margin="0,0,0,12" Visibility="Collapsed"/><Button x:Name="Logout" Content="Выйти" Background="Transparent"/></StackPanel></ScrollViewer>
<Grid x:Name="Admin" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,26"><TextBlock Text="Пользователи" FontSize="28" FontWeight="SemiBold"/><Button x:Name="LegacyUsersButton" Content="Пользователи Legacy" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
<ListBox x:Name="Users"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="#A6A6A6" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Параметры доступа" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,16"/><TextBlock Text="Имя пользователя" Foreground="#A6A6A6" Margin="0,0,0,8"/><TextBox x:Name="Username"/><TextBlock Text="Активна до, включительно" Foreground="#A6A6A6" Margin="0,22,0,8"/><Button x:Name="Days" HorizontalContentAlignment="Left"/><CheckBox x:Name="Unlimited" Content="Без ограничения срока" Margin="0,16,0,24"/><Button x:Name="ChangeSub" Content="Сохранить подписку" Background="#EEEEEE" Foreground="#171717"/><Button x:Name="Issue" Content="Выпустить ключ" Margin="0,10,0,0"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="Toggle" Content="Вкл / выкл" Padding="10,11"/><Button Grid.Column="2" x:Name="RoleButton" Content="Роль" Padding="10,11"/></Grid><Button x:Name="Create" Content="Создать пользователя" Margin="0,24,0,0"/><Button x:Name="Remove" Content="Удалить пользователя" Background="Transparent" Foreground="#C0A6A6" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Grid></Grid>
<Grid x:Name="Servers" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,26"><StackPanel><TextBlock Text="Серверы" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Состояние и лимиты всей сети" Foreground="#A6A6A6" Margin="0,8,0,0"/></StackPanel><Button x:Name="RefreshServers" Content="Обновить" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
<ListBox x:Name="Nodes"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="#CACACA" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="{Binding Address}" Foreground="#888888" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<StackPanel Grid.Column="2"><TextBlock x:Name="NodeTitle" Text="Выберите сервер" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,10"/><TextBlock Text="Лимиты применяются через сеть, даже если прямой маршрут недоступен." TextWrapping="Wrap" Foreground="#A6A6A6" FontSize="12" Margin="0,0,0,24"/><TextBlock Text="Максимум потоков" Foreground="#A6A6A6" Margin="0,0,0,8"/><TextBox x:Name="StreamLimit"/><TextBlock Text="Рабочие каналы" Foreground="#A6A6A6" Margin="0,22,0,8"/><TextBox x:Name="WorkerLimit"/><Button x:Name="SaveServer" Content="Сохранить лимиты" Background="#EEEEEE" Foreground="#171717" Margin="0,24,0,0"/></StackPanel></Grid></Grid>
</Grid><TextBlock x:Name="Message" Grid.Row="1" Foreground="#B5B5B5" TextWrapping="Wrap" FontSize="12" Margin="0,22,0,0"/></Grid></Grid></Window>
