GARLIC_NODE_ROLE=ru
GARLIC_NODE_LABEL=garlic-entry
GARLIC_DNS_BIND=0.0.0.0:8443
GARLIC_PUBLIC_URL=https://entry.example.invalid:8443
GARLIC_REQUIRE_DEVICE_LEASE=1
GARLIC_AUTH_FILE=/home/garlic/.local/share/garlic/entry/accounts.json
GARLIC_STATE_FILE=/home/garlic/.local/share/garlic/entry/state.json
GARLIC_NETWORK_FILE=/home/garlic/.local/share/garlic/entry/network.json
GARLIC_NODE_IDENTITY_FILE=/home/garlic/.local/share/garlic/entry/identity.json
GARLIC_INFRA_KEYS_FILE=/home/garlic/.config/garlic/infra-keys.json
GARLIC_TLS_CERT=/home/garlic/.config/garlic/entry-cert.pem
GARLIC_TLS_KEY=/home/garlic/.config/garlic/entry-key.pem
GARLIC_CA_CERT=/home/garlic/.config/garlic/ca.pem
