GARLIC_NODE_ROLE=exit
GARLIC_NODE_LABEL=garlic-exit
GARLIC_STORAGE_BIND=0.0.0.0:8443
GARLIC_PUBLIC_URL=https://exit.example.invalid:8443
GARLIC_DNS_URL=https://entry.example.invalid:8443
GARLIC_ACCOUNT_AUTHORITY=https://entry.example.invalid:8443
GARLIC_NETWORK_UPSTREAM=https://entry.example.invalid:8443
GARLIC_USER_SYNC_INTERVAL_MS=5000
GARLIC_REQUIRE_DEVICE_LEASE=1
GARLIC_AUTH_FILE=/home/garlic/.local/share/garlic/exit/accounts.json
GARLIC_STORAGE_STATE_FILE=/home/garlic/.local/share/garlic/exit/state.json
GARLIC_NETWORK_FILE=/home/garlic/.local/share/garlic/exit/network.json
GARLIC_NODE_IDENTITY_FILE=/home/garlic/.local/share/garlic/exit/identity.json
GARLIC_INFRA_KEYS_FILE=/home/garlic/.config/garlic/infra-keys.json
GARLIC_TLS_CERT=/home/garlic/.config/garlic/exit-cert.pem
GARLIC_TLS_KEY=/home/garlic/.config/garlic/exit-key.pem
GARLIC_CA_CERT=/home/garlic/.config/garlic/ca.pem
GARLIC_RELAY_MAX_STREAMS=512
GARLIC_RELAY_CONNECTIONS=2
